# Campus Love — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.

# Supabase Project URL — find this in your Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Anonymous (public) Key — find this in your Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase Service Role Key (server-side only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=

