{
  "expo": {
    "name": "UniDate",
    "slug": "unidate",
    "scheme": "unidate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unidate.campus",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "UniDate needs access to your camera to capture student profile pictures and ID documents for campus verification.",
        "NSPhotoLibraryUsageDescription": "UniDate needs access to your photo library to upload your campus profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unidate.campus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6B21A8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniDate needs access to your photo library to select campus profile pictures.",
          "cameraPermission": "UniDate needs access to your camera to take profile photos and student verification selfies."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "unidate-campus-love-prod"
      }
    }
  }
}
